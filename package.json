{
  "name": "tonder-web-sdk",
  "version": "2.0.1",
  "description": "tonder sdk for integrations",
  "scripts": {
    "start": "webpack-dev-server",
    "build": "webpack --config webpack.config.js --mode production",
    "build-stage": "webpack --config webpack.config.js",
    "prepare": "husky install",
    "format": "prettier --write .",
    "lint": "eslint 'src/**/*.js'",
    "lint:fix": "eslint 'src/**/*.js' --fix"
  },
  "author": "",
  "main": "v2/bundle.min.js",
  "types": "types/index.d.ts",
  "files": [
    "v2",
    "types",
    "LICENSE",
    "README.md"
  ],
  "license": "ISC",
  "dependencies": {
    "accordion-js": "^3.4.0",
    "crypto-js": "^4.2.0",
    "lodash.get": "^4.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.1",
    "@babel/preset-env": "^7.29.1",
    "@maskito/core": "^3.0.1",
    "babel-loader": "^9.2.1",
    "css-loader": "^6.11.0",
    "cypress": "^15.21.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "3.4.2",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0",
    "webpack-obfuscator": "^3.6.1"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npm run format",
      "npm run lint:fix"
    ]
  }
}
